# telegram-bridge.service - TEMPLATE ONLY. Do NOT install without review.
# Runs the Telegram channel supervisor: bot A (muse) + bot B (pi) long-pollers
# and the pi dispatch loop, in ONE process. Outbound-only (long-poll
# getUpdates); no inbound ports, no public IP needed.
# The Muse side is pull-based: the hook script wakes the agent, which uses
# bin/telegram-muse-batch to pull/reply/ack.
#
# SECURITY NOTE (TECH_PLAN v3.1 §2.4): All units run as the dedicated
# low-privilege wechat-bridge user. Deploy-time setup must grant it write
# access only to the paths listed in ReadWritePaths below.
[Unit]
Description=Telegram bridge - dual bot pollers + Pi dispatch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wechat-bridge
Group=wechat-bridge
WorkingDirectory=/home/hatch/workspace/wechat-pi-bridge
Environment=WB_HOME=/home/hatch/workspace/wechat-pi-bridge
Environment=HOME=/var/lib/wechat-pi-bridge/pi-home
Environment=WB_PI_HOME=/var/lib/wechat-pi-bridge/pi-home
Environment=WB_PI_SESSION_DIR=/var/lib/wechat-pi-bridge/pi-home/sessions
Environment=NODE_USE_ENV_PROXY=1
Environment=NODE_OPTIONS=--max-old-space-size=128
Environment=SSL_CERT_FILE=/run/hatch/egress-tls/ca-bundle.pem
Environment=NODE_EXTRA_CA_CERTS=/run/hatch/egress-tls/ca-bundle.pem
Environment=REQUESTS_CA_BUNDLE=/run/hatch/egress-tls/ca-bundle.pem
Environment=CURL_CA_BUNDLE=/run/hatch/egress-tls/ca-bundle.pem
Environment=https_proxy=http://hatch-runtime:__PROXY_PASSWORD__@hatch-egress-proxy:3128
Environment=HTTPS_PROXY=http://hatch-runtime:__PROXY_PASSWORD__@hatch-egress-proxy:3128
Environment=http_proxy=http://hatch-runtime:__PROXY_PASSWORD__@hatch-egress-proxy:3128
Environment=HTTP_PROXY=http://hatch-runtime:__PROXY_PASSWORD__@hatch-egress-proxy:3128
Environment=all_proxy=http://hatch-runtime:__PROXY_PASSWORD__@hatch-egress-proxy:3128
Environment=ALL_PROXY=http://hatch-runtime:__PROXY_PASSWORD__@hatch-egress-proxy:3128
Environment=no_proxy=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2,fd8b:4f84:7d32:99::1,[fd8b:4f84:7d32:99::1],fd8b:4f84:7d32:99::2,[fd8b:4f84:7d32:99::2]
Environment=NO_PROXY=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2,fd8b:4f84:7d32:99::1,[fd8b:4f84:7d32:99::1],fd8b:4f84:7d32:99::2,[fd8b:4f84:7d32:99::2]
ExecStart=/home/hatch/workspace/wechat-pi-bridge/bin/telegram-bridge
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10
TimeoutStopSec=20
KillMode=control-group
MemoryMax=512M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=yes
ReadWritePaths=/home/hatch/workspace/wechat-pi-bridge/state /home/hatch/workspace/wechat-pi-bridge/logs /home/hatch/workspace/wechat-pi-bridge/sandbox /var/lib/wechat-pi-bridge/pi-home /var/lib/wechat-pi-bridge/pi-home/sessions

[Install]
WantedBy=default.target
