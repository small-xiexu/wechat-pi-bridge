# wx-bot-muse.service - TEMPLATE ONLY. Do NOT install without review.
# wx-bot process for the MUSE binding (delivery: pull).
# Scan QR with WeChat 小号A: wx-bot --config <config> login muse
[Unit]
Description=wx-bot iLink bridge - muse binding (pull)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
Environment=WB_HOME=/home/hatch/workspace/wechat-pi-bridge
Environment=HOME=/var/lib/wechat-pi-bridge/pi-home
Environment=WB_PI_HOME=/var/lib/wechat-pi-bridge/pi-home
Environment=WB_PI_SESSION_DIR=/var/lib/wechat-pi-bridge/pi-home/sessions
WorkingDirectory=/home/hatch/workspace/wechat-pi-bridge
ExecStartPre=/home/hatch/workspace/wechat-pi-bridge/bin/check-deps
ExecStart=/home/hatch/workspace/wechat-pi-bridge/vendor/wx-bot/wx-bot --config /home/hatch/workspace/wechat-pi-bridge/config/wx-bot-muse.json run
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
MemoryMax=256M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=yes
ReadWritePaths=/home/hatch/workspace/wechat-pi-bridge/state /home/hatch/workspace/wechat-pi-bridge/logs /home/hatch/workspace/wechat-pi-bridge/sandbox /var/lib/wechat-pi-bridge/pi-home /var/lib/wechat-pi-bridge/pi-home/sessions

[Install]
WantedBy=default.target
